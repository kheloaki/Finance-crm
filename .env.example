# Convex — run `npm run convex:sync` after `npm run dev:convex` to merge URLs here
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Local app URL (also pushed to Convex as SITE_URL via `npm run auth:setup`)
SITE_URL=http://localhost:3000

# Password reset emails (Convex dashboard → Settings → Environment Variables)
# AUTH_RESEND_KEY=re_xxxxxxxx
# AUTH_EMAIL=FINANCE CRM <onboarding@resend.dev>

# Vercel only — set these in Project Settings → Environment Variables
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=
# SITE_URL=https://your-app.vercel.app
# CONVEX_DEPLOY_KEY=  (optional — only if build uses `npm run build:prod`)
# AUTH_RESEND_KEY=
# AUTH_EMAIL=